// The one place a kernel is named. Including this file with NN_KERNEL defined
// generates, from a single line per kernel:
//
//   kernel_api.h      the KernelTable slot
//   naive_kernels.h   the naive_<name> declaration
//   cuda_kernels.h    the cuda_<name> declaration
//   registry.cpp      both backends' registrations, and the null check
//
// That works because every backend function is named <backend>_<slot> and the
// Fn aliases are function types rather than pointers-to-function, so a line
// like `GemmFn naive_gemm;` declares a function with exactly the signature the
// table wants. Add a kernel by adding a line here, the alias in kernel_api.h,
// and the two bodies -- nothing else.
//
// Elementwise ops are NOT kernels. They are lines in unary_ops.def,
// binary_ops.def or scalar_ops.def, and ride on the six slots below.
//
// NN_KERNEL(slot, FnAlias)

// gemm
NN_KERNEL(gemm,                  GemmFn)

// elementwise, dispatched on an op code
NN_KERNEL(unary,                 UnaryFn)
NN_KERNEL(unary_backward,        UnaryBackwardFn)
NN_KERNEL(binary,                BinaryFn)
NN_KERNEL(binary_backward,       BinaryBackwardFn)
NN_KERNEL(scalar,                ScalarFn)
NN_KERNEL(scalar_backward,       ScalarBackwardFn)

// reductions
NN_KERNEL(argmax_rows,           ArgmaxRowsFn)
NN_KERNEL(sum_to,                SumToFn)
NN_KERNEL(sum_all,               SumAllFn)
NN_KERNEL(sum_all_strided,       SumAllStridedFn)

// whole-buffer writes that are not elementwise maps
NN_KERNEL(axpy,                  AxpyFn)
NN_KERNEL(fill,                  FillFn)
NN_KERNEL(fill_from,             FillFromFn)

// softmax
NN_KERNEL(softmax_rows,          SoftmaxRowsFn)
NN_KERNEL(softmax_rows_backward, SoftmaxRowsBackwardFn)
NN_KERNEL(softmax_ce,            SoftmaxCeFn)
NN_KERNEL(softmax_ce_backward,   SoftmaxCeBackwardFn)

// embedding
NN_KERNEL(embedding,             EmbeddingFn)
NN_KERNEL(embedding_backward,    EmbeddingBackwardFn)

// optimisers
NN_KERNEL(adam_step,             AdamStepFn)

// copies
NN_KERNEL(copy_strided,          CopyStridedFn)
NN_KERNEL(copy_strided_i32,      CopyStridedI32Fn)
NN_KERNEL(copy_into_strided,     CopyIntoStridedFn)
