// One line per elementwise unary op: just its enum name and its spelling as
// a method/free function (x.method(), autograd::method(x)).
//
//   NN_UNARY(Name, method)
//
// This list's only job is naming -- the enum, the name-lookup table, the op
// count, and the wrapper declarations/definitions in autograd/functions.h,
// core/tensor.h, autograd/functions.cpp and test_elementwise_ops.cpp all
// come from it, and none of those files ever look at an op's math.

NN_UNARY(Neg,     neg)
NN_UNARY(Abs,     abs)
NN_UNARY(Sign,    sign)
NN_UNARY(Relu,    relu)
NN_UNARY(Exp,     exp)
NN_UNARY(Log,     log)
NN_UNARY(Sqrt,    sqrt)
NN_UNARY(Rsqrt,   rsqrt)
NN_UNARY(Recip,   recip)
NN_UNARY(Tanh,    tanh)
NN_UNARY(Sigmoid, sigmoid)
NN_UNARY(Gelu,    gelu)
NN_UNARY(Silu,    silu)
