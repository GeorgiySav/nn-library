// One line per elementwise binary op: just its enum name and its spelling as
// a method/free function.
//
//   NN_BINARY(Name, method)

NN_BINARY(Add,     add)
NN_BINARY(Sub,     sub)
NN_BINARY(Mul,     mul)
NN_BINARY(Div,     div)
NN_BINARY(Pow,     pow)
NN_BINARY(Maximum, maximum)
NN_BINARY(Minimum, minimum)
